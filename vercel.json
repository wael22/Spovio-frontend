{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "spovio.net"
        }
      ],
      "destination": "https://www.spovio.net/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(sw.js|registerSW.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.spovio.net/api/$1"
    },
    {
      "source": "/arbitre",
      "destination": "https://api.spovio.net/arbitre"
    },
    {
      "source": "/watch/(.*)",
      "destination": "https://api.spovio.net/watch/$1"
    },
    {
      "source": "/live",
      "destination": "https://api.spovio.net/live"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://api.spovio.net/static/$1"
    },
    {
      "source": "/s/:shareToken",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}